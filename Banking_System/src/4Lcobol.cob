       1000-INITIALIZE SECTION.
       1000-INIT.
      * INITIALIZATION SECTION - OPEN FILES, CICS SETUP
           OPEN INPUT REPORT-FILE
                OUTPUT BACKUP-FILE.
           EXEC SQL
               DECLARE CURS000001 CURSOR FOR
               SELECT * FROM TRANSACTION_TBL
               WHERE LAST_UPDATED > 0
           END-EXEC.
           EXEC SQL
               DECLARE CURS000002 CURSOR FOR
               SELECT * FROM ACCOUNT_MASTER
               WHERE STATUS > 0
           END-EXEC.
           EXEC SQL
               DECLARE CURS000003 CURSOR FOR
               SELECT * FROM ACCOUNT_MASTER
               WHERE BALANCE > 0
           END-EXEC.
           EXEC SQL
               DECLARE CURS000004 CURSOR FOR
               SELECT * FROM ACCOUNT_MASTER
               WHERE AMOUNT > 0
           END-EXEC.
           EXEC SQL
